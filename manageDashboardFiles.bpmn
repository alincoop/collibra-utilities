    <laneSet id="laneSet_manageDashboardFiles"><lane id="lane1"><flowNodeRef>start</flowNodeRef><flowNodeRef>actionGateway</flowNodeRef><flowNodeRef>unknownAction</flowNodeRef><flowNodeRef>validateUpload</flowNodeRef><flowNodeRef>existsGateway</flowNodeRef><flowNodeRef>confirmOverwrite</flowNodeRef><flowNodeRef>overwriteGateway</flowNodeRef><flowNodeRef>saveFile</flowNodeRef><flowNodeRef>discardUpload</flowNodeRef><flowNodeRef>listFiles</flowNodeRef><flowNodeRef>chooseFile</flowNodeRef><flowNodeRef>deleteGateway</flowNodeRef><flowNodeRef>deleteFile</flowNodeRef><flowNodeRef>end</flowNodeRef><flowNodeRef>flow1</flowNodeRef><flowNodeRef>toUpload</flowNodeRef><flowNodeRef>toDelete</flowNodeRef><flowNodeRef>toUnknown</flowNodeRef><flowNodeRef>flow5</flowNodeRef><flowNodeRef>flow6</flowNodeRef><flowNodeRef>toConfirm</flowNodeRef><flowNodeRef>toSaveNew</flowNodeRef><flowNodeRef>flow9</flowNodeRef><flowNodeRef>toOverwrite</flowNodeRef><flowNodeRef>toDiscard</flowNodeRef><flowNodeRef>flow12</flowNodeRef><flowNodeRef>flow13</flowNodeRef><flowNodeRef>flow14</flowNodeRef><flowNodeRef>flow15</flowNodeRef><flowNodeRef>toDeleteFile</flowNodeRef><flowNodeRef>toCancelDelete</flowNodeRef><flowNodeRef>flow18</flowNodeRef></lane></laneSet>
    <startEvent id="start" name="Start" flowable:initiator="initiator" flowable:formFieldValidation="false"><extensionElements><flowable:formProperty id="section" name="File location (folder under the dgc data directory)" type="string" default="custom-dashboards" readable="false" required="true"></flowable:formProperty><flowable:formProperty id="allowedExtensions" name="Allowed upload file extensions (comma-separated)" type="string" default="png,jpg,jpeg,gif,svg,html,css,js" readable="false" required="true"></flowable:formProperty><flowable:formProperty id="action" name="Action" type="enum" default="upload" required="true"><flowable:value id="upload" name="Upload a file"></flowable:value><flowable:value id="delete" name="Delete a file"></flowable:value></flowable:formProperty><flowable:formProperty id="fileUpload" name="File to upload (only for Upload)" type="fileUpload" required="false"></flowable:formProperty><flowable:work-form-field-validation><![CDATA[false]]></flowable:work-form-field-validation><design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid></extensionElements></startEvent>
    <exclusiveGateway id="actionGateway" name="Action?" default="toUnknown"><extensionElements><design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid></extensionElements></exclusiveGateway>
    <scriptTask id="unknownAction" name="Reject unknown action" scriptFormat="groovy" flowable:autoStoreVariables="false"><extensionElements><design:stencilid><![CDATA[ScriptTask]]></design:stencilid></extensionElements><script><![CDATA[// #importFile NONE
import com.collibra.dgc.workflow.api.exception.WorkflowException

def ex = new WorkflowException("Choose either Upload or Delete.")
ex.setTitleMessage("Unknown Action")
throw ex
]]></script></scriptTask>
    <scriptTask id="validateUpload" name="Validate upload" scriptFormat="groovy" flowable:autoStoreVariables="false"><extensionElements><design:stencilid><![CDATA[ScriptTask]]></design:stencilid></extensionElements><script><![CDATA[// #importFile NONE
import com.collibra.dgc.workflow.api.exception.WorkflowException

def fail = { String title, String message ->
    def ex = new WorkflowException(message)
    ex.setTitleMessage(title)
    throw ex
}

// Resolve the configured folder; plain folder names only
String sectionName = (section ?: "").trim()
if (!(sectionName ==~ /[A-Za-z0-9._-]+/) || sectionName.contains("..")) {
    fail("Invalid Configuration", "The configured file location is not a valid folder name.")
}
File folder = new File(System.getProperty("collibra.data.dir") + File.separator + "dgc" + File.separator + sectionName)

if (!fileUpload) {
    fail("No File Attached", "Attach a file to upload.")
}

// Plain file names only: no folders or path tricks
def fileInfo = fileApi.getFileInfo(string2Uuid(fileUpload))
String name = (fileInfo.getName() ?: "").trim()
if (!(name ==~ /[A-Za-z0-9][A-Za-z0-9._ -]{0,200}/) || name.contains("..")) {
    fail("Invalid File Name", "File names may only contain letters, digits, spaces, dots, dashes and underscores.")
}

// Extension allow-list from the configuration variable
List<String> allowed = (allowedExtensions ?: "").split(",").toList().collect { it.trim().toLowerCase() }.findAll { it }
String ext = name.contains(".") ? name.substring(name.lastIndexOf(".") + 1).toLowerCase() : ""
if (!allowed.contains(ext)) {
    fail("File Type Not Allowed", "Allowed file types: " + allowed.join(", ") + ".")
}

File target = new File(folder, name)
if (target.isDirectory()) {
    fail("Invalid File Name", "'" + name + "' is a folder name and cannot be used.")
}

execution.setVariable("uploadFileName", name)
execution.setVariable("fileExists", target.exists())
]]></script></scriptTask>
    <exclusiveGateway id="existsGateway" name="File exists?" default="toSaveNew"><extensionElements><design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid></extensionElements></exclusiveGateway>
    <userTask id="confirmOverwrite" name="Confirm overwrite of ${uploadFileName}" flowable:candidateUsers="user(${initiator})" flowable:formFieldValidation="false"><documentation>${uploadFileName} already exists in the dashboard folder. Overwrite it with the uploaded file?</documentation><extensionElements><flowable:formProperty id="overwriteButton" name="Overwrite" type="button" default="false"></flowable:formProperty><flowable:formProperty id="cancelOverwriteButton" name="Cancel" type="button" default="false"></flowable:formProperty><flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type><design:stencilid><![CDATA[FormTask]]></design:stencilid><design:candidatestype><![CDATA[all]]></design:candidatestype></extensionElements></userTask>
    <exclusiveGateway id="overwriteGateway" name="Overwrite?" default="toDiscard"><extensionElements><design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid></extensionElements></exclusiveGateway>
    <scriptTask id="saveFile" name="Save file" scriptFormat="groovy" flowable:autoStoreVariables="false"><extensionElements><design:stencilid><![CDATA[ScriptTask]]></design:stencilid></extensionElements><script><![CDATA[// #importFile NONE
import com.collibra.dgc.workflow.api.exception.WorkflowException

def fail = { String title, String message ->
    def ex = new WorkflowException(message)
    ex.setTitleMessage(title)
    throw ex
}

// Resolve the configured folder; plain folder names only
String sectionName = (section ?: "").trim()
if (!(sectionName ==~ /[A-Za-z0-9._-]+/) || sectionName.contains("..")) {
    fail("Invalid Configuration", "The configured file location is not a valid folder name.")
}
File folder = new File(System.getProperty("collibra.data.dir") + File.separator + "dgc" + File.separator + sectionName)

String name = uploadFileName
File target = new File(folder, name)

// Re-check: someone may have added the file since validation
boolean overwriteConfirmed = execution.getVariable("overwriteButton") == true
if (target.exists() && !overwriteConfirmed) {
    fail("File Already Exists", "'" + name + "' already exists. Start the workflow again to confirm overwriting it.")
}

folder.mkdirs()
UUID tempFileId = string2Uuid(fileUpload)
fileApi.getFileAsStream(tempFileId).withCloseable { input ->
    target.withOutputStream { output -> output << input }
}

// Remove the temporary upload from Collibra file storage
try {
    fileApi.deleteFile(tempFileId)
} catch (Exception e) {
    loggerApi.warn("Manage Dashboard Files >>> could not remove temporary upload " + tempFileId + ": " + e.getMessage())
}

loggerApi.info("Manage Dashboard Files >>> " + initiator + " uploaded '" + name + "' to " + sectionName + (overwriteConfirmed ? " (overwrite)" : ""))
]]></script></scriptTask>
    <scriptTask id="discardUpload" name="Discard upload" scriptFormat="groovy" flowable:autoStoreVariables="false"><extensionElements><design:stencilid><![CDATA[ScriptTask]]></design:stencilid></extensionElements><script><![CDATA[// #importFile NONE
// Overwrite cancelled: remove the temporary upload from Collibra file storage
try {
    fileApi.deleteFile(string2Uuid(fileUpload))
} catch (Exception e) {
    loggerApi.warn("Manage Dashboard Files >>> could not remove temporary upload " + fileUpload + ": " + e.getMessage())
}
loggerApi.info("Manage Dashboard Files >>> " + initiator + " cancelled overwriting '" + uploadFileName + "'")
]]></script></scriptTask>
    <scriptTask id="listFiles" name="List dashboard files" scriptFormat="groovy" flowable:autoStoreVariables="false"><extensionElements><design:stencilid><![CDATA[ScriptTask]]></design:stencilid></extensionElements><script><![CDATA[// #importFile NONE
import com.collibra.dgc.workflow.api.exception.WorkflowException

def fail = { String title, String message ->
    def ex = new WorkflowException(message)
    ex.setTitleMessage(title)
    throw ex
}

// Resolve the configured folder; plain folder names only
String sectionName = (section ?: "").trim()
if (!(sectionName ==~ /[A-Za-z0-9._-]+/) || sectionName.contains("..")) {
    fail("Invalid Configuration", "The configured file location is not a valid folder name.")
}
File folder = new File(System.getProperty("collibra.data.dir") + File.separator + "dgc" + File.separator + sectionName)

// Options for the dropdown: [fileName: fileName], sorted by name
Map<String, String> fileOptions = new LinkedHashMap<String, String>()
File[] entries = folder.listFiles()
if (entries != null) {
    entries.findAll { it.isFile() }
           .sort { it.getName().toLowerCase() }
           .each { fileOptions.put(it.getName(), it.getName()) }
}

if (fileOptions.isEmpty()) {
    fail("No Files Found", "There are no files in the dashboard folder to delete.")
}

execution.setVariable("fileOptions", fileOptions)
]]></script></scriptTask>
    <userTask id="chooseFile" name="Choose a dashboard file to delete" flowable:candidateUsers="user(${initiator})" flowable:formFieldValidation="false"><documentation>Pick the file to delete. This cannot be undone.</documentation><extensionElements><flowable:formProperty id="fileToDelete" name="File to delete" type="dynamicEnum" required="false"><flowable:value id="dynamicValuesExpression" name="${fileOptions}"></flowable:value></flowable:formProperty><flowable:formProperty id="deleteButton" name="Delete" type="button" default="false"></flowable:formProperty><flowable:formProperty id="cancelDeleteButton" name="Cancel" type="button" default="false"></flowable:formProperty><flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type><design:stencilid><![CDATA[FormTask]]></design:stencilid><design:candidatestype><![CDATA[all]]></design:candidatestype></extensionElements></userTask>
    <exclusiveGateway id="deleteGateway" name="Delete?" default="toCancelDelete"><extensionElements><design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid></extensionElements></exclusiveGateway>
    <scriptTask id="deleteFile" name="Delete file" scriptFormat="groovy" flowable:autoStoreVariables="false"><extensionElements><design:stencilid><![CDATA[ScriptTask]]></design:stencilid></extensionElements><script><![CDATA[// #importFile NONE
import com.collibra.dgc.workflow.api.exception.WorkflowException

def fail = { String title, String message ->
    def ex = new WorkflowException(message)
    ex.setTitleMessage(title)
    throw ex
}

// Resolve the configured folder; plain folder names only
String sectionName = (section ?: "").trim()
if (!(sectionName ==~ /[A-Za-z0-9._-]+/) || sectionName.contains("..")) {
    fail("Invalid Configuration", "The configured file location is not a valid folder name.")
}
File folder = new File(System.getProperty("collibra.data.dir") + File.separator + "dgc" + File.separator + sectionName)

String name = (execution.getVariable("fileToDelete") ?: "").toString().trim()
if (!name) {
    fail("No File Selected", "Choose a file to delete.")
}

// Plain file names only: no folders or path tricks
File target = new File(folder, name)
if (name.contains("..") || !target.getParentFile().equals(folder) || !target.isFile()) {
    fail("File Not Found", "'" + name + "' no longer exists in the dashboard folder.")
}

if (!target.delete()) {
    fail("Delete Failed", "'" + name + "' could not be deleted. Check the server logs.")
}

loggerApi.info("Manage Dashboard Files >>> " + initiator + " deleted '" + name + "' from " + sectionName)
]]></script></scriptTask>
